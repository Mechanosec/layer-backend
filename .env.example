# Deployment configuration only. Tuning values (timeouts, retry counts, batch
# sizes, safety-buffer default) are constants in the code — see
# src/shared/ecom-api/constants, src/modules/stock/constants,
# src/modules/ecom/constants.

# App
PORT=3000
LOG_LEVEL=info

# PostgreSQL (used by docker-compose and by Prisma)
POSTGRES_USER=layer
POSTGRES_PASSWORD=layer
POSTGRES_DB=layer
POSTGRES_PORT=5432
DATABASE_URL="postgresql://layer:layer@localhost:5432/layer?schema=public"

# Kafka
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=layer-backend
KAFKA_CONSUMER_GROUP=layer-backend
KAFKA_TOPIC_BC_PRODUCT=bc.product.global
KAFKA_TOPIC_BC_STOCK=bc.stock.unit
KAFKA_TOPIC_ECOM_STOCK=ecom.stock.updated

# E-com API — queried during every calculation for the reservations term
# ("кількість товарів доданих в ордери в статусі «Новий»").
ECOM_API_URL=http://localhost:4000
# ECOM_API_TOKEN=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
